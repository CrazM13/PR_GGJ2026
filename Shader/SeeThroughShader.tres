code = "shader_type canvas_item;
render_mode blend_mix;




void fragment() {
// Input:5
	vec2 n_out5p0 = UV;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(TEXTURE, n_out5p0);
	float n_out6p4 = n_out6p0.a;


// Input:2
	vec2 n_out2p0 = SCREEN_UV;


// Distance:3
	vec2 n_in3p1 = vec2(0.50000, 0.50000);
	float n_out3p0 = distance(n_out2p0, n_in3p1);


// FloatOp:8
	float n_in8p1 = 9.00000;
	float n_out8p0 = n_out3p0 * n_in8p1;


// Clamp:9
	float n_in9p1 = 0.00000;
	float n_in9p2 = 1.00000;
	float n_out9p0 = clamp(n_out8p0, n_in9p1, n_in9p2);


// FloatOp:7
	float n_out7p0 = n_out9p0 * n_out6p4;


// Output:0
	COLOR.rgb = vec3(n_out6p0.xyz);
	COLOR.a = n_out7p0;


}
"
